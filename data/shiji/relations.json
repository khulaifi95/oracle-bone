{
	"$comment": "人物关系。每条：a、b 两人；p 为分期，[起年, 止年, 类, b 之于 a, a 之于 b]，年为公元纪年（负为前），null 为不详或终身；类：kin 亲族，lord 君臣主从，ally 交游同盟，foe 敌对，other 其他。note 一句点出此关系在史文中的关节。",
	"relations": [
		{"a": "xiang-yu", "b": "xiang-liang", "p": [[null, -208, "kin", "叔父", "从子"]], "note": "项梁杀人，与籍避仇吴中，教籍书、剑、兵法；同起会稽。梁死定陶，籍代领其众。"},
		{"a": "xiang-yu", "b": "xiang-yan", "p": [[null, null, "kin", "祖父", "孙"]], "note": "项燕为秦将王翦所戮，项氏世世为楚将。"},
		{"a": "xiang-liang", "b": "xiang-yan", "p": [[null, null, "kin", "父", "子"]]},
		{"a": "xiang-yu", "b": "xiang-bo", "p": [[null, null, "kin", "季父", "从子"]], "note": "项氏族中暗护刘邦者：鸿门宴前夜驰告张良，席间又以身翼蔽沛公。"},
		{"a": "xiang-yu", "b": "xiang-zhuang", "p": [[null, null, "kin", "从弟", "从兄"]], "note": "鸿门宴上舞剑，意常在沛公。"},
		{"a": "xiang-yu", "b": "fan-zeng", "p": [[-208, -204, "lord", "亚父", "主"]], "note": "项羽尊为亚父。鸿门劝杀沛公不听；荥阳中陈平反间，项王疑之，稍夺其权，范增怒去，未至彭城，疽发背而死。"},
		{"a": "xiang-liang", "b": "fan-zeng", "p": [[-208, -208, "lord", "谋士", "主"]], "note": "年七十，往说项梁立楚怀王之孙心，以从民望。"},
		{"a": "xiang-yu", "b": "yu-ji", "p": [[null, -202, "kin", "美人", "所幸"]], "note": "名虞，常幸从。垓下夜饮帐中，项王悲歌「虞兮虞兮奈若何」。"},
		{"a": "xiang-yu", "b": "long-ju", "p": [[-208, -203, "lord", "部将", "主"]], "note": "将兵救齐，与韩信夹潍水而阵；信壅水半渡而击，杀龙且。"},
		{"a": "xiang-yu", "b": "zhongli-mo", "p": [[-206, -202, "lord", "部将", "主"]], "note": "陈平反间，言其功多而不得裂地，项王不信之。"},
		{"a": "han-xin", "b": "zhongli-mo", "p": [[-202, -201, "ally", "故交", "故交"]], "note": "楚亡，钟离眜素与韩信善，亡归信；信持其首谒高祖，眜骂曰「公非长者」。"},
		{"a": "xiang-yu", "b": "cao-jiu", "p": [[-206, -203, "lord", "大司马", "主"]], "note": "守成皋，项王戒勿与战；汉数挑战辱之，咎怒渡汜水，半渡被击，与司马欣皆自刭。"},
		{"a": "cao-jiu", "b": "sima-xin", "p": [[null, -203, "ally", "旧交", "旧交"]], "note": "项梁尝坐栎阳狱，蕲狱掾曹咎书抵栎阳狱掾司马欣，事得已。"},
		{"a": "xiang-yu", "b": "ying-bu", "p": [[-208, -204, "lord", "部将", "主"], [-204, -202, "foe", "叛将", "故主"]], "note": "常为楚军冠；坑秦卒、击杀义帝皆使布为之。后称病不佐楚，疑惧，随何说之归汉。"},
		{"a": "liu-bang", "b": "ying-bu", "p": [[-204, -197, "lord", "淮南王", "君"], [-196, -196, "foe", "反者", "所讨"]], "note": "韩信、彭越既诛，布恐而反；高祖亲击之，为流矢所中，归而病。"},
		{"a": "ying-bu", "b": "sui-he", "p": [[-204, -204, "other", "说客", "所说"]], "note": "随何使九江，当楚使之面劝英布，布遂杀楚使归汉。"},
		{"a": "ying-bu", "b": "wu-rui", "p": [[null, null, "kin", "岳父", "婿"]], "note": "番君吴芮以女妻之。"},
		{"a": "xiang-yu", "b": "song-yi", "p": [[-208, -207, "lord", "上将军", "次将"], [-207, -207, "foe", "所斩", "斩之者"]], "note": "救赵途中，宋义留安阳四十六日不进；项羽晨朝上将军，即其帐中斩其头，诸将慑服。"},
		{"a": "xiang-liang", "b": "huai-wang", "p": [[-208, -208, "lord", "所立之君", "立之者"]], "note": "项梁求楚怀王孙心于民间，立以为楚怀王，从民望也。"},
		{"a": "xiang-yu", "b": "huai-wang", "p": [[-208, -206, "lord", "君", "臣"], [-205, -205, "foe", "所弑", "弑之者"]], "note": "怀王与诸将约「先入定关中者王之」。项羽阳尊为义帝而徙之，阴令英布等击杀于江中。"},
		{"a": "liu-bang", "b": "huai-wang", "p": [[-208, -206, "lord", "君", "臣"]], "note": "怀王遣沛公西入关；义帝死，汉王为之发丧，以此号召诸侯伐楚。"},
		{"a": "xiang-yu", "b": "liu-bang", "p": [[-208, -207, "ally", "约为兄弟", "约为兄弟"], [-206, -202, "foe", "敌", "敌"]], "note": "初同受怀王命，约为兄弟；鸿门之后相争五年，划鸿沟而复战，终围项王于垓下。"},
		{"a": "xiang-yu", "b": "zhang-han", "p": [[-208, -207, "foe", "敌将", "敌"], [-207, -205, "lord", "降将", "主"]], "note": "巨鹿之后，章邯约降殷虚，项羽立为雍王，而坑秦降卒二十余万于新安城南。"},
		{"a": "xiang-liang", "b": "chen-ying", "p": [[-208, -208, "lord", "部将", "主"]], "note": "东阳少年欲立陈婴为王；其母曰暴得大名不祥，婴乃以兵属项梁。"},
		{"a": "xiang-yu", "b": "huan-chu", "p": [[-209, -206, "lord", "部将", "主"]], "note": "项梁起事时桓楚亡在泽中，唯项籍知其处。"},
		{"a": "xiang-yu", "b": "yin-tong", "p": [[-209, -209, "foe", "所斩", "斩之者"]], "note": "会稽守殷通欲发兵，召项梁；梁目籍，籍拔剑斩守头，遂举吴中兵。"},
		{"a": "xiang-yu", "b": "zhou-yin", "p": [[-206, -203, "lord", "大司马", "主"], [-202, -202, "foe", "叛将", "故主"]], "note": "垓下之前，周殷叛楚，以舒屠六，举九江兵迎黥布。"},
		{"a": "xiang-yu", "b": "lü-matong", "p": [[-202, -202, "foe", "故人", "故人"]], "note": "乌江，项王见汉骑司马吕马童曰「若非吾故人乎」，乃自刎，以头与之。"},
		{"a": "xiang-yu", "b": "yang-xi", "p": [[-202, -202, "foe", "追者", "所追"]], "note": "郎中骑杨喜追项王，项王瞋目叱之，人马俱惊，辟易数里；后分得其一体，封赤泉侯。"},
		{"a": "xiang-yu", "b": "guan-ying", "p": [[-202, -202, "foe", "追者", "所追"]], "note": "灌婴以骑兵追项王至东城，其所部斩项王。"},
		{"a": "liu-bang", "b": "zhang-liang", "p": [[-207, -195, "lord", "谋臣", "主"]], "note": "运筹帷幄之中，决胜千里之外：鸿门脱险、烧绝栈道、下邑之谋、借箸阻立六国后、劝封雍齿，皆出于良。"},
		{"a": "zhang-liang", "b": "xiang-bo", "p": [[null, -202, "ally", "故交", "故交"]], "note": "项伯尝杀人，从张良匿；鸿门前夜驰告良，良引见沛公，二人约为婚姻。"},
		{"a": "liu-bang", "b": "xiang-bo", "p": [[-206, -202, "ally", "亲家", "亲家"]], "note": "鸿门前夜，沛公奉卮酒为寿，约为婚姻；汉兴，赐姓刘，封射阳侯。"},
		{"a": "zhang-liang", "b": "huang-shi-gong", "p": [[-218, -218, "other", "授书者", "受书者"]], "note": "下邳圯上，老父堕履，使良取而履之；授以《太公兵法》。"},
		{"a": "zhang-liang", "b": "han-cheng", "p": [[-208, -206, "lord", "韩王", "司徒"]], "note": "张良五世相韩。项梁立韩成为韩王，良为司徒；项羽杀成，良遂间行归汉。"},
		{"a": "xiang-yu", "b": "han-cheng", "p": [[-206, -206, "foe", "所杀", "杀之者"]]},
		{"a": "zhang-liang", "b": "qin-shihuang", "p": [[-218, -218, "foe", "所刺", "刺客"]], "note": "为韩报仇，与力士狙击秦皇帝于博浪沙中，误中副车。"},
		{"a": "liu-bang", "b": "xiao-he", "p": [[-209, -195, "lord", "丞相", "君"]], "note": "沛主吏掾，早从起事；入咸阳独收秦律令图书；守关中，给馈饷不绝；荐韩信。论功第一。"},
		{"a": "han-xin", "b": "xiao-he", "p": [[-206, -197, "ally", "荐主", "所荐"], [-196, -196, "foe", "诱杀者", "所诛"]], "note": "萧何月下追韩信，荐为大将；后与吕后谋，诈召信入长乐宫斩之。「成也萧何，败也萧何」。"},
		{"a": "liu-bang", "b": "cao-can", "p": [[-209, -195, "lord", "功臣", "君"]], "note": "沛狱掾，从起；攻城野战，身被七十创。"},
		{"a": "xiao-he", "b": "cao-can", "p": [[null, -193, "ally", "同僚", "同僚"]], "note": "皆沛县吏，后有隙；何病笃，荐参自代，「萧规曹随」。"},
		{"a": "liu-bang", "b": "fan-kuai", "p": [[-209, -195, "lord", "连襟、部将", "主"]], "note": "沛屠狗者，娶吕后妹吕媭。鸿门闯帐，责项王，沛公得脱。"},
		{"a": "liu-bang", "b": "xiahou-ying", "p": [[-209, -195, "lord", "太仆", "主"]], "note": "沛厩司御，素与高祖善；彭城败，高祖急，数蹶孝惠、鲁元下车，婴常收载之。"},
		{"a": "liu-ying", "b": "xiahou-ying", "p": [[-205, -205, "ally", "护驾者", "所护"]]},
		{"a": "liu-bang", "b": "zhou-bo", "p": [[-209, -195, "lord", "部将", "主"]], "note": "织薄曲、吹箫给丧事者；重厚少文，高祖曰「安刘氏者必勃也」。"},
		{"a": "liu-bang", "b": "guan-ying", "p": [[-208, -195, "lord", "部将", "主"]], "note": "睢阳贩缯者；为骑将，追斩项王。"},
		{"a": "liu-bang", "b": "lu-wan", "p": [[null, -196, "ally", "同日生之友", "同日生之友"], [-195, -195, "foe", "亡入匈奴", "故主"]], "note": "与高祖同里同日生，壮又相爱；出入卧内，封燕王。高祖疑之，绾亡入匈奴。"},
		{"a": "liu-bang", "b": "peng-yue", "p": [[-205, -202, "ally", "盟将", "汉王"], [-202, -197, "lord", "梁王", "君"], [-196, -196, "foe", "所诛", "诛之者"]], "note": "游兵梁地，数绝楚粮道；垓下之会后封梁王。称病不从击陈豨，吕后劝诛之，夷三族，醢其肉。"},
		{"a": "lü-zhi", "b": "peng-yue", "p": [[-196, -196, "foe", "所诛", "诛之者"]]},
		{"a": "liu-bang", "b": "ji-xin", "p": [[-204, -204, "lord", "将军", "主"]], "note": "荥阳急，纪信乘王车诈降楚，汉王从西门遁出。"},
		{"a": "xiang-yu", "b": "ji-xin", "p": [[-204, -204, "foe", "所烧杀", "烧杀之者"]]},
		{"a": "liu-bang", "b": "zhou-ke", "p": [[-204, -204, "lord", "御史大夫", "主"]], "note": "守荥阳；城破，骂项王，被烹。"},
		{"a": "liu-bang", "b": "wei-bao", "p": [[-205, -205, "ally", "附王", "盟主"], [-205, -204, "foe", "叛者", "讨之者"]], "note": "从汉击楚，彭城败后反，韩信虏之；守荥阳时为周苛所杀。"},
		{"a": "wei-bao", "b": "wei-jiu", "p": [[null, null, "kin", "从兄", "从弟"]], "note": "魏咎自烧杀，豹继为魏王。"},
		{"a": "wei-bao", "b": "han-xin", "p": [[-205, -205, "foe", "虏之者", "所虏"]]},
		{"a": "wei-bao", "b": "zhou-ke", "p": [[-204, -204, "foe", "杀之者", "所杀"]], "note": "周苛曰「反国之王，难与守城」，遂杀之。"},
		{"a": "liu-bang", "b": "liu-jia", "p": [[null, null, "kin", "从兄", "从弟"]]},
		{"a": "liu-bang", "b": "lü-zhi", "p": [[null, -195, "kin", "妻", "夫"]], "note": "单父人吕公善相，以女妻刘季。"},
		{"a": "liu-bang", "b": "taigong", "p": [[null, null, "kin", "父", "子"]], "note": "彭城败后为楚所质；广武，项王置太公俎上欲烹之，汉王曰「幸分我一杯羹」。"},
		{"a": "xiang-yu", "b": "taigong", "p": [[-205, -203, "foe", "人质", "执之者"]]},
		{"a": "liu-bang", "b": "liu-ying", "p": [[null, null, "kin", "子", "父"]]},
		{"a": "lü-zhi", "b": "liu-ying", "p": [[null, null, "kin", "子", "母"]]},
		{"a": "lü-zhi", "b": "lü-ze", "p": [[null, null, "kin", "兄", "妹"]]},
		{"a": "lü-zhi", "b": "han-xin", "p": [[-196, -196, "foe", "所诛", "诛之者"]]},
		{"a": "liu-ying", "b": "sihao", "p": [[-196, -196, "ally", "羽翼", "所辅"]], "note": "张良为吕后计，迎四皓辅太子；高祖见之曰「羽翼已成，难动矣」，易太子之议遂罢。"},
		{"a": "liu-bang", "b": "li-yiji", "p": [[-207, -204, "lord", "说客", "主"]], "note": "高阳酒徒，长揖不拜；说齐王田广，下七十余城。"},
		{"a": "li-yiji", "b": "tian-guang", "p": [[-204, -204, "foe", "烹之者", "所烹"]], "note": "韩信用蒯通计袭齐，田广以为郦生卖己，烹之。"},
		{"a": "liu-bang", "b": "chen-ping", "p": [[-205, -195, "lord", "护军中尉", "主"]], "note": "先事魏咎、项羽，后归汉；反间楚君臣、伪游云梦擒韩信、解白登之围，皆其奇计。"},
		{"a": "chen-ping", "b": "fan-zeng", "p": [[-204, -204, "foe", "反间所中", "行反间者"]], "note": "以恶草具进楚使，佯惊曰「吾以为亚父使」，项王遂疑亚父。"},
		{"a": "chen-ping", "b": "xiang-yu", "p": [[-206, -205, "lord", "故主", "故臣"]]},
		{"a": "chen-ping", "b": "wei-jiu", "p": [[-208, -208, "lord", "故主", "故臣"]]},
		{"a": "liu-bang", "b": "yong-chi", "p": [[-208, -208, "foe", "叛将", "故主"], [-201, -195, "lord", "所封", "君"]], "note": "以丰叛降魏，高祖最恨之；张良劝先封雍齿，群臣乃安。"},
		{"a": "liu-bang", "b": "shu-sun-tong", "p": [[-205, -195, "lord", "博士", "主"]], "note": "制朝仪；高祖曰「吾乃今日知为皇帝之贵也」。"},
		{"a": "liu-bang", "b": "han-xin", "p": [[-206, -203, "lord", "大将", "主"], [-203, -202, "lord", "齐王", "汉王"], [-201, -196, "foe", "淮阴侯", "疑之者"]], "note": "定三秦、虏魏豹、破赵、降燕、下齐、杀龙且。蒯通劝三分天下而不从，云梦被擒，降为淮阴侯，终死长乐钟室。"},
		{"a": "han-xin", "b": "xiang-yu", "p": [[-208, -206, "lord", "故主", "郎中"], [-206, -202, "foe", "敌", "敌"]], "note": "初从项梁、项羽为郎中，数以策干项羽不用，亡归汉。"},
		{"a": "han-xin", "b": "kuai-tong", "p": [[-203, -203, "ally", "谋士", "所说"]], "note": "劝信背汉，三分天下；信不忍。临死悔不用蒯通之计。"},
		{"a": "han-xin", "b": "wu-she", "p": [[-203, -203, "other", "说客", "所说"]], "note": "项王遣武涉说信反汉，信谢曰「汉王解衣衣我，推食食我」。"},
		{"a": "han-xin", "b": "piaomu", "p": [[null, null, "ally", "恩人", "所饭"]], "note": "钓于城下，漂母饭信数十日；信为楚王，赐千金。"},
		{"a": "han-xin", "b": "li-zuoche", "p": [[-204, -204, "ally", "所师", "师事之者"]], "note": "井陉破赵，购得广武君，解其缚，东乡坐，师事之；用其策不战而下燕。"},
		{"a": "han-xin", "b": "chen-xi", "p": [[-197, -196, "ally", "同谋", "同谋"]], "note": "陈豨拜为代相，过辞信；信挈其手与谋。豨反，信欲从中起，事泄。"},
		{"a": "han-xin", "b": "zhang-er", "p": [[-205, -204, "ally", "同伐赵", "同伐赵"]]},
		{"a": "han-xin", "b": "chen-yu", "p": [[-204, -204, "foe", "所斩", "斩之者"]], "note": "背水为阵，斩成安君泜水上。"},
		{"a": "han-xin", "b": "zhao-xie", "p": [[-204, -204, "foe", "所擒", "擒之者"]]},
		{"a": "han-xin", "b": "tian-guang", "p": [[-203, -203, "foe", "所破", "破之者"]]},
		{"a": "han-xin", "b": "long-ju", "p": [[-203, -203, "foe", "所杀", "杀之者"]]},
		{"a": "han-xin", "b": "zhang-han", "p": [[-206, -205, "foe", "所围", "围之者"]], "note": "汉还定三秦，围章邯于废丘。"},
		{"a": "liu-bang", "b": "han-wang-xin", "p": [[-205, -201, "lord", "韩王", "君"], [-201, -196, "foe", "降匈奴者", "所讨"]]},
		{"a": "liu-bang", "b": "chen-xi", "p": [[-200, -198, "lord", "代相", "君"], [-197, -196, "foe", "反者", "所讨"]]},
		{"a": "liu-bang", "b": "zang-tu", "p": [[-206, -203, "foe", "敌", "敌"], [-203, -202, "lord", "燕王", "君"], [-202, -202, "foe", "反者", "所讨"]], "note": "汉五年反，高祖自将击虏之，以卢绾代为燕王。"},
		{"a": "chen-sheng", "b": "wu-guang", "p": [[-209, -208, "ally", "同起者", "同起者"]], "note": "同为屯长，大泽乡杀尉起事；吴广围荥阳不下，为部将田臧矫王令所杀。"},
		{"a": "wu-guang", "b": "tian-zang", "p": [[-208, -208, "foe", "杀之者", "所杀"]]},
		{"a": "chen-sheng", "b": "tian-zang", "p": [[-209, -208, "lord", "部将", "主"]], "note": "矫王令杀吴广，陈王反赐之楚令尹印。"},
		{"a": "chen-sheng", "b": "zhuang-jia", "p": [[-209, -208, "lord", "御者", "主"], [-208, -208, "foe", "弑之者", "所弑"]], "note": "陈王走下城父，其御庄贾杀之以降秦。"},
		{"a": "chen-sheng", "b": "lü-chen", "p": [[-209, -208, "lord", "涓人", "主"]], "note": "陈王死，吕臣为苍头军，攻杀庄贾，复以陈为楚。"},
		{"a": "lü-chen", "b": "zhuang-jia", "p": [[-208, -208, "foe", "所杀", "杀之者"]]},
		{"a": "chen-sheng", "b": "wu-chen", "p": [[-209, -209, "lord", "部将", "主"], [-209, -208, "ally", "自立者", "名义之主"]], "note": "徇赵，用张耳、陈馀计自立为赵王；陈王怒，不得已而贺之。"},
		{"a": "wu-chen", "b": "zhang-er", "p": [[-209, -208, "lord", "谋士", "主"]]},
		{"a": "wu-chen", "b": "chen-yu", "p": [[-209, -208, "lord", "谋士", "主"]]},
		{"a": "wu-chen", "b": "han-guang", "p": [[-209, -209, "lord", "部将", "主"], [-209, -208, "ally", "自立者", "故主"]], "note": "使略燕，燕人立广为王；赵、燕自此各立。"},
		{"a": "chen-sheng", "b": "zhou-wen", "p": [[-209, -209, "lord", "部将", "主"]], "note": "西击秦至戏，为章邯所破，自刭。"},
		{"a": "zhou-wen", "b": "zhang-han", "p": [[-209, -209, "foe", "破之者", "所破"]]},
		{"a": "chen-sheng", "b": "ge-ying", "p": [[-209, -209, "lord", "部将", "主"], [-209, -209, "foe", "所诛", "诛之者"]], "note": "略地至东城，立襄彊为楚王；闻陈王已立，杀襄彊还报，陈王诛之。"},
		{"a": "chen-sheng", "b": "zhou-fu", "p": [[-209, -208, "lord", "部将", "主"]], "note": "徇魏地，立魏咎为魏王，自为魏相。"},
		{"a": "zhou-fu", "b": "wei-jiu", "p": [[-209, -208, "lord", "所立之王", "相"]], "note": "魏咎往来陈中五反，陈王乃遣立之。"},
		{"a": "chen-sheng", "b": "cai-ci", "p": [[-209, -208, "lord", "上柱国", "主"]]},
		{"a": "chen-sheng", "b": "zhang-han", "p": [[-209, -208, "foe", "敌", "敌"]], "note": "章邯破陈，陈王走下城父。"},
		{"a": "qin-jia", "b": "jing-ju", "p": [[-208, -208, "lord", "所立之王", "立之者"]], "note": "陈王败，秦嘉立景驹为楚王。"},
		{"a": "xiang-liang", "b": "qin-jia", "p": [[-208, -208, "foe", "所杀", "杀之者"]]},
		{"a": "xiang-liang", "b": "jing-ju", "p": [[-208, -208, "foe", "所逐", "逐之者"]]},
		{"a": "xiang-liang", "b": "zhang-han", "p": [[-208, -208, "foe", "杀之者", "所杀"]], "note": "定陶，项梁轻秦有骄色；章邯夜衔枚击之，杀项梁。"},
		{"a": "xiang-liang", "b": "tian-rong", "p": [[-208, -208, "ally", "所救", "救之者"], [-208, -208, "foe", "不发兵者", "所怨"]], "note": "项梁救田荣于东阿；后田荣不肯发兵助楚，楚由是怨之。"},
		{"a": "tian-dan", "b": "tian-rong", "p": [[null, -208, "kin", "从弟", "从兄"]]},
		{"a": "tian-dan", "b": "tian-heng", "p": [[null, -208, "kin", "从弟", "从兄"]]},
		{"a": "tian-rong", "b": "tian-heng", "p": [[null, -205, "kin", "弟", "兄"]], "note": "田荣死，田横收散兵，立荣子广为齐王而相之。"},
		{"a": "tian-rong", "b": "tian-guang", "p": [[null, -205, "kin", "子", "父"]]},
		{"a": "tian-dan", "b": "tian-shi", "p": [[null, -208, "kin", "子", "父"]]},
