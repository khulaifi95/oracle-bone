{
	"$comment": "人物关系。每条：a、b 两人；p 为分期，[起年, 止年, 类, b 之于 a, a 之于 b]，年为公元纪年（负为前），null 为不详或终身；类：kin 亲族，lord 君臣主从，ally 交游同盟，foe 敌对，other 其他。note 一句点出此关系在史文中的关节。",
	"relations": [
		{"a": "cao-cao", "b": "cao-pi", "p": [[null, null, "kin", "子", "父"]], "note": "建安二十二年立为魏太子；太祖薨，嗣魏王，旋受汉禅。"},
		{"a": "cao-pi", "b": "cao-rui", "p": [[null, null, "kin", "子", "父"]], "note": "文帝以其母甄氏被诛，久不立为嗣；临崩乃立之。"},
		{"a": "cao-cao", "b": "cao-ren", "p": [[null, null, "kin", "从弟", "从兄"]]},
		{"a": "cao-cao", "b": "cao-zhen", "p": [[null, null, "kin", "族子（养子）", "养父"]], "note": "父曹邵为太祖募兵被害，太祖哀其少孤，收养与诸子同。"},
		{"a": "cao-cao", "b": "xiahou-dun", "p": [[189, 220, "lord", "元从宿将", "主"]], "note": "太祖父曹嵩本夏侯氏之子（裴注引《曹瞒传》），惇、渊于太祖为族中兄弟行。"},
		{"a": "cao-cao", "b": "xiahou-yuan", "p": [[189, 219, "lord", "宿将", "主"]], "note": "督汉中，定军山为黄忠所斩。太祖常戒之曰「为将当有怯弱时」。"},
		{"a": "huang-zhong", "b": "xiahou-yuan", "p": [[219, 219, "foe", "所斩", "斩之者"]], "note": "定军山，忠推锋必进，一战斩渊。"},
		{"a": "cao-cao", "b": "xun-yu", "p": [[191, 212, "lord", "王佐之才", "主"]], "note": "太祖曰「吾之子房也」。劝迎天子、官渡坚守；后不欲太祖进爵魏公，以忧薨（一说饮药）。"},
		{"a": "cao-cao", "b": "guo-jia", "p": [[196, 207, "lord", "谋士", "主"]], "note": "十胜十败之论；北征乌桓还而卒。赤壁败后太祖叹「郭奉孝在，不使孤至此」。"},
		{"a": "cao-cao", "b": "sima-yi", "p": [[208, 220, "lord", "主簿", "主"]], "note": "太祖察其有雄豪志，谓太子曰「司马懿非人臣也」。"},
		{"a": "cao-pi", "b": "sima-yi", "p": [[208, 226, "lord", "心腹", "主"]], "note": "太子中庶子时即见信重；文帝临崩，与曹真等受遗诏辅政。"},
		{"a": "cao-rui", "b": "sima-yi", "p": [[226, 239, "lord", "辅政大臣", "君"]]},
		{"a": "cao-rui", "b": "cao-zhen", "p": [[226, 231, "lord", "辅政大臣", "君"]]},
		{"a": "cao-pi", "b": "cao-zhen", "p": [[null, null, "kin", "族兄", "族弟"]]},
		{"a": "sima-yi", "b": "cao-zhen", "p": [[226, 231, "ally", "同受遗诏", "同受遗诏"]]},
		{"a": "sima-yi", "b": "zhuge-liang", "p": [[231, 234, "foe", "敌", "敌"]], "note": "五丈原相持百余日，亮遗以巾帼妇人之服；亮卒，懿案行其营垒，叹曰「天下奇才也」。"},
		{"a": "cao-cao", "b": "zhang-liao", "p": [[198, 220, "lord", "降将", "主"]], "note": "本属吕布，下邳破而归太祖；合肥以八百人冲孙权十万之众。"},
		{"a": "zhang-liao", "b": "lu-bu", "p": [[194, 198, "lord", "故主", "部将"]]},
		{"a": "zhang-liao", "b": "sun-quan", "p": [[215, 215, "foe", "所破", "破之者"]], "note": "逍遥津之战，几获孙权；江东小儿闻其名不敢夜啼（后世之说）。"},
		{"a": "zhang-liao", "b": "guan-yu", "p": [[200, 200, "ally", "故交", "故交"]], "note": "太祖使辽问关羽去留，羽曰「吾终不留，要当立效以报曹公乃去」。"},
		{"a": "cao-cao", "b": "yu-jin", "p": [[192, 219, "lord", "宿将", "主"]], "note": "樊城水淹，于禁降关羽；后归魏，文帝使谒高陵，见壁画降状，惭恚发病而死。"},
		{"a": "yu-jin", "b": "guan-yu", "p": [[219, 219, "foe", "受降者", "降者"]]},
		{"a": "yu-jin", "b": "pang-de", "p": [[219, 219, "ally", "同救樊", "同救樊"]], "note": "同救樊城，庞德不降而死，于禁降。太祖叹「吾知禁三十年，何意临危处难，反不如庞德邪」。"},
		{"a": "pang-de", "b": "ma-chao", "p": [[null, 214, "lord", "故主", "部将"]], "note": "随马超入汉中，后归太祖。"},
		{"a": "pang-de", "b": "guan-yu", "p": [[219, 219, "foe", "杀之者", "所杀"]], "note": "被擒，立而不跪，骂羽，遂为所杀。"},
		{"a": "cao-cao", "b": "zhang-he", "p": [[200, 220, "lord", "降将", "主"]], "note": "官渡之战降太祖。"},
		{"a": "zhang-he", "b": "yuan-shao", "p": [[191, 200, "lord", "故主", "部将"]]},
		{"a": "zhang-he", "b": "ma-su", "p": [[228, 228, "foe", "所破", "破之者"]], "note": "街亭，张郃绝其汲道，大破马谡。"},
		{"a": "zhang-he", "b": "zhuge-liang", "p": [[228, 231, "foe", "敌", "敌"]], "note": "追亮至木门，中矢而死。"},
		{"a": "cao-cao", "b": "han-xiandi", "p": [[196, 220, "lord", "天子", "丞相"]], "note": "建安元年迎帝都许，「奉天子以令不臣」；以女曹节为帝后。"},
		{"a": "cao-pi", "b": "han-xiandi", "p": [[220, 220, "other", "禅位者", "受禅者"]], "note": "延康元年，汉帝禅位于魏，封山阳公。"},
		{"a": "dong-zhuo", "b": "han-xiandi", "p": [[189, 192, "lord", "所立之君", "立之者"]], "note": "废少帝，立陈留王协，是为献帝。"},
		{"a": "han-lingdi", "b": "han-xiandi", "p": [[null, null, "kin", "子", "父"]]},
		{"a": "he-jin", "b": "han-lingdi", "p": [[null, 189, "kin", "妹婿", "内兄"]], "note": "何进以妹为灵帝皇后而贵。"},
		{"a": "dong-zhuo", "b": "he-jin", "p": [[189, 189, "other", "召之者", "应召者"]], "note": "何进谋诛宦官，召董卓引兵入京；进先为宦官所杀，卓遂专朝政。"},
		{"a": "dong-zhuo", "b": "lu-bu", "p": [[189, 192, "kin", "义子", "义父"], [192, 192, "foe", "杀之者", "所杀"]], "note": "卓以吕布为骑都尉，誓为父子；王允说布，布手刃卓。"},
		{"a": "dong-zhuo", "b": "cao-cao", "p": [[189, 190, "foe", "敌", "敌"]], "note": "太祖变易姓名东归，散家财起兵讨卓。"},
		{"a": "yuan-shao", "b": "dong-zhuo", "p": [[190, 191, "foe", "敌", "讨伐之盟主"]], "note": "关东州郡起兵讨卓，推袁绍为盟主。"},
		{"a": "sun-jian", "b": "dong-zhuo", "p": [[190, 191, "foe", "敌", "敌"]], "note": "孙坚破卓军阳人，斩华雄，进入洛阳，修塞诸陵。"},
		{"a": "yuan-shao", "b": "yuan-shu", "p": [[null, null, "kin", "从弟（一说异母弟）", "从兄"]], "note": "兄弟相恶：袁术骂绍为家奴，两家各结外援相攻。"},
		{"a": "yuan-shao", "b": "cao-cao", "p": [[null, 190, "ally", "少时之交", "少时之交"], [190, 198, "ally", "盟友", "盟友"], [199, 202, "foe", "敌", "敌"]], "note": "少时同游；官渡之战，太祖烧乌巢，绍军大溃，发病呕血而死。"},
		{"a": "yuan-shao", "b": "yuan-tan", "p": [[null, null, "kin", "长子", "父"]]},
		{"a": "yuan-shao", "b": "yuan-shang", "p": [[null, null, "kin", "少子", "父"]], "note": "绍爱少子尚，未定嗣而卒；兄弟相攻，太祖得以各个击破。"},
		{"a": "yuan-tan", "b": "yuan-shang", "p": [[null, null, "kin", "弟", "兄"], [203, 205, "foe", "仇", "仇"]]},
		{"a": "shen-pei", "b": "yuan-shao", "p": [[191, 202, "lord", "主", "谋臣"]]},
		{"a": "shen-pei", "b": "yuan-shang", "p": [[202, 204, "lord", "所立之主", "立之者"]], "note": "矫绍遗命立尚为嗣；守邺城不降，见杀。"},
		{"a": "cao-cao", "b": "shen-pei", "p": [[204, 204, "foe", "所杀", "杀之者"]]},
		{"a": "cao-cao", "b": "yuan-tan", "p": [[203, 204, "ally", "降而复叛者", "所依"], [205, 205, "foe", "所斩", "斩之者"]]},
		{"a": "cao-cao", "b": "yuan-shang", "p": [[202, 207, "foe", "敌", "敌"]]},
		{"a": "yuan-shao", "b": "gongsun-zan", "p": [[191, 199, "foe", "敌", "敌"]], "note": "易京之围，瓒自焚死。"},
		{"a": "liu-bei", "b": "gongsun-zan", "p": [[null, 199, "ally", "同学", "同学"]], "note": "同师卢植，先主以兄事之；后为瓒别部司马。"},
		{"a": "liu-bei", "b": "zhao-yun", "p": [[200, 229, "lord", "部将", "主"]], "note": "本属公孙瓒；长坂，先主弃妻子南走，云身抱弱子，即后主也。"},
		{"a": "zhao-yun", "b": "gongsun-zan", "p": [[191, 199, "lord", "故主", "部将"]]},
		{"a": "zhao-yun", "b": "liu-shan", "p": [[208, 208, "ally", "所救", "救之者"]]},
		{"a": "yuan-shu", "b": "sun-jian", "p": [[190, 191, "ally", "部将", "所依"]], "note": "袁术表孙坚领豫州刺史。"},
		{"a": "yuan-shu", "b": "sun-ce", "p": [[194, 197, "lord", "部将", "主"], [197, 199, "foe", "绝之者", "所绝"]], "note": "策依术，借兵渡江；术僭号称帝，策以书责而绝之。"},
		{"a": "yuan-shu", "b": "lu-bu", "p": [[193, 198, "ally", "时盟时敌", "时盟时敌"]]},
		{"a": "yuan-shu", "b": "liu-bei", "p": [[196, 199, "foe", "敌", "敌"]], "note": "争徐州。"},
		{"a": "sun-jian", "b": "sun-ce", "p": [[null, null, "kin", "长子", "父"]]},
		{"a": "sun-jian", "b": "sun-quan", "p": [[null, null, "kin", "次子", "父"]]},
		{"a": "sun-ce", "b": "sun-quan", "p": [[null, null, "kin", "弟", "兄"]], "note": "策临终授权印绶曰：「举江东之众，决机于两陈之间，卿不如我；举贤任能，各尽其心，以保江东，我不如卿」。"},
		{"a": "sun-jian", "b": "huang-zu", "p": [[191, 191, "foe", "杀之者", "所杀"]], "note": "孙坚征刘表，单马行岘山，为黄祖军士所射杀。"},
		{"a": "sun-jian", "b": "liu-biao", "p": [[191, 191, "foe", "敌", "敌"]]},
		{"a": "sun-quan", "b": "huang-zu", "p": [[203, 208, "foe", "父仇", "敌"]], "note": "建安十三年，孙权破江夏，斩黄祖，报父仇。"},
		{"a": "gan-ning", "b": "huang-zu", "p": [[null, 207, "lord", "故主", "部将"]], "note": "黄祖以凡人畜之，宁遂奔吴。"},
		{"a": "gan-ning", "b": "sun-quan", "p": [[208, 220, "lord", "主", "部将"]]},
		{"a": "sun-ce", "b": "zhou-yu", "p": [[null, 200, "ally", "总角之好、连襟", "总角之好、连襟"]], "note": "同年，升堂拜母；分娶桥公二女。"},
		{"a": "sun-quan", "b": "zhou-yu", "p": [[200, 210, "lord", "中护军", "主"]], "note": "受遗佐权，以兄礼事之；赤壁力主拒曹。"},
		{"a": "zhou-yu", "b": "lu-su", "p": [[null, 210, "ally", "知己", "知己"]], "note": "鲁肃指囷以相赠；瑜荐肃于权，临终以肃自代。"},
		{"a": "zhou-yu", "b": "cao-cao", "p": [[208, 209, "foe", "敌", "敌"]], "note": "赤壁火攻，曹军烧溺死者甚众。"},
		{"a": "zhou-yu", "b": "huang-gai", "p": [[208, 209, "lord", "部将", "上司"]], "note": "黄盖献火攻、诈降之计。"},
		{"a": "huang-gai", "b": "cao-cao", "p": [[208, 208, "foe", "所诈", "诈降者"]]},
		{"a": "zhou-yu", "b": "cheng-pu", "p": [[208, 210, "ally", "同僚", "同僚"]], "note": "程普初颇陵侮瑜，瑜折节容下；普后敬服曰「与周公瑾交，若饮醇醪，不觉自醉」。"},
		{"a": "cheng-pu", "b": "sun-jian", "p": [[190, 191, "lord", "主", "旧将"]], "note": "孙氏三世旧将。"},
		{"a": "sun-quan", "b": "lu-su", "p": [[200, 217, "lord", "赞军校尉", "主"]], "note": "榻上对：鼎足江东，竟长江所极，据而有之。"},
		{"a": "lu-su", "b": "liu-bei", "p": [[208, 217, "ally", "所迎", "迎之者"]], "note": "当阳迎先主，劝结孙刘之好；又劝权借荆州于先主。"},
		{"a": "lu-su", "b": "guan-yu", "p": [[215, 217, "foe", "对手", "对手"]], "note": "单刀会：益阳相见，各驻兵马百步上，诸将军单刀俱会。"},
		{"a": "lu-su", "b": "lu-meng", "p": [[210, 217, "ally", "后进", "前辈"]], "note": "「士别三日，即更刮目相待」；肃拍其背，升堂拜母，结友而别。"},
		{"a": "lu-su", "b": "zhuge-liang", "p": [[208, 217, "ally", "友", "友"]], "note": "肃谓亮曰「我子瑜友也」，即共定交。"},
		{"a": "sun-quan", "b": "lu-meng", "p": [[200, 219, "lord", "大都督", "主"]]},
		{"a": "lu-meng", "b": "guan-yu", "p": [[219, 219, "foe", "所袭", "袭之者"]], "note": "白衣渡江，袭取荆州，关羽失其根本。"},
		{"a": "lu-meng", "b": "lu-xun", "p": [[219, 219, "ally", "所荐", "荐之者"]], "note": "吕蒙称疾，荐陆逊代守陆口，羽遂不备。"},
		{"a": "sun-quan", "b": "lu-xun", "p": [[203, 245, "lord", "大都督", "主"]]},
		{"a": "lu-xun", "b": "sun-ce", "p": [[null, null, "kin", "岳父", "婿"]], "note": "孙权以兄策之女妻逊。"},
		{"a": "lu-xun", "b": "liu-bei", "p": [[221, 222, "foe", "敌", "敌"]], "note": "夷陵，陆逊连营火攻，先主败走白帝。"},
		{"a": "sun-quan", "b": "zhang-zhao", "p": [[200, 236, "lord", "长史", "主"]], "note": "策临终托权于昭；赤壁之议，昭等劝迎曹，权终不以为相。"},
		{"a": "sun-ce", "b": "zhang-zhao", "p": [[194, 200, "lord", "长史", "主"]]},
		{"a": "sun-ce", "b": "taishi-ci", "p": [[195, 195, "foe", "酣斗之敌", "酣斗之敌"], [195, 200, "lord", "部将", "主"]], "note": "神亭酣斗，策得其手戟，慈亦得策兜鍪；后为策所擒，解缚用之。"},
		{"a": "sun-quan", "b": "taishi-ci", "p": [[200, 206, "lord", "部将", "主"]]},
		{"a": "sun-quan", "b": "zhuge-jin", "p": [[200, 241, "lord", "长史", "主"]]},
		{"a": "zhuge-jin", "b": "zhuge-liang", "p": [[null, null, "kin", "弟", "兄"]], "note": "兄弟各事其主；使蜀与亮公会相见，退无私面。"},
		{"a": "sun-quan", "b": "cao-cao", "p": [[208, 219, "foe", "敌", "敌"]], "note": "太祖望权军，叹曰「生子当如孙仲谋」。"},
		{"a": "sun-quan", "b": "liu-bei", "p": [[208, 215, "ally", "盟友、妹夫", "盟友、妻兄"], [219, 222, "foe", "敌", "敌"]], "note": "赤壁同盟；权以妹妻先主。后争荆州，袭杀关羽，夷陵大破蜀军。"},
		{"a": "sun-quan", "b": "guan-yu", "p": [[215, 219, "foe", "所杀", "杀之者"]], "note": "权遣使为子索羽女，羽骂辱其使，不许婚；后擒斩羽于临沮。"},
		{"a": "sun-quan", "b": "cao-pi", "p": [[221, 222, "lord", "封之者", "所封吴王"]]},
		{"a": "liu-bei", "b": "guan-yu", "p": [[184, 219, "lord", "恩若兄弟", "主"]], "note": "寝则同床，恩若兄弟；而稠人广坐，侍立终日。"},
		{"a": "liu-bei", "b": "zhang-fei", "p": [[184, 221, "lord", "恩若兄弟", "主"]]},
		{"a": "guan-yu", "b": "zhang-fei", "p": [[184, 219, "ally", "弟", "兄"]], "note": "飞年少，羽年长数岁，飞兄事之。"},
		{"a": "guan-yu", "b": "cao-cao", "p": [[200, 200, "lord", "所降", "降者"], [200, 219, "foe", "敌", "敌"]], "note": "刺颜良于万众之中；尽封所赐，拜书告辞，奔先主于袁军。"},
		{"a": "guan-yu", "b": "huang-zhong", "p": [[219, 219, "ally", "同列", "同列"]], "note": "羽闻黄忠位与己并，怒曰「大丈夫终不与老兵同列」。"},
		{"a": "guan-yu", "b": "ma-chao", "p": [[214, 219, "ally", "同僚", "同僚"]], "note": "羽书问诸葛亮：马超人才可谁比类？亮答「犹未及髯之绝伦逸群也」。"},
		{"a": "liu-bei", "b": "zhuge-liang", "p": [[207, 223, "lord", "军师", "主"]], "note": "三顾茅庐，隆中对策；「孤之有孔明，犹鱼之有水也」。白帝托孤：「若嗣子可辅，辅之；如其不才，君可自取」。"},
		{"a": "zhuge-liang", "b": "liu-shan", "p": [[223, 234, "lord", "所辅之主", "相父"]], "note": "出师表：「亲贤臣，远小人，此先汉所以兴隆也」。"},
		{"a": "zhuge-liang", "b": "xu-shu", "p": [[null, 208, "ally", "友", "友"]], "note": "徐庶荐亮为「卧龙」；母为曹军所获，辞先主北去。"},
		{"a": "liu-bei", "b": "xu-shu", "p": [[201, 208, "lord", "谋士", "主"]]},
		{"a": "zhuge-liang", "b": "pang-tong", "p": [[null, 214, "ally", "齐名之友", "齐名之友"]], "note": "卧龙、凤雏，并为司马徽所称。"},
		{"a": "liu-bei", "b": "pang-tong", "p": [[210, 214, "lord", "军师中郎将", "主"]], "note": "劝先主取益州；雒城中流矢而卒。"},
		{"a": "pang-tong", "b": "zhou-yu", "p": [[209, 210, "lord", "上司", "功曹"]], "note": "周瑜领南郡，统为功曹；瑜卒，统送丧至吴。"},
		{"a": "liu-bei", "b": "fa-zheng", "p": [[211, 220, "lord", "谋主", "主"]], "note": "本刘璋之臣，迎先主入蜀；定军山之谋出其手。"},
		{"a": "fa-zheng", "b": "liu-zhang", "p": [[196, 211, "lord", "故主", "臣"]]},
		{"a": "zhuge-liang", "b": "fa-zheng", "p": [[214, 220, "ally", "同僚", "同僚"]], "note": "先主东征败，亮叹曰「法孝直若在，则能制主上，令不东行」。"},
		{"a": "liu-bei", "b": "ma-chao", "p": [[214, 222, "lord", "骠骑将军", "主"]]},
		{"a": "ma-chao", "b": "cao-cao", "p": [[211, 211, "foe", "敌", "敌"]], "note": "潼关之战；太祖叹「马儿不死，吾无葬地也」。"},
		{"a": "ma-chao", "b": "zhang-lu", "p": [[212, 214, "lord", "所依", "依附者"]]},
		{"a": "liu-bei", "b": "huang-zhong", "p": [[209, 220, "lord", "部将", "主"]]},
		{"a": "liu-bei", "b": "wei-yan", "p": [[209, 223, "lord", "汉中太守", "主"]], "note": "先主问之，延对曰「若曹操举天下而来，请为大王拒之」。"},
		{"a": "wei-yan", "b": "zhuge-liang", "p": [[223, 234, "lord", "丞相", "部将"]], "note": "请兵万人，循子午谷直取长安，亮不许；延常谓亮为怯。亮卒后与杨仪相争而死。"},
		{"a": "zhuge-liang", "b": "ma-su", "p": [[221, 228, "lord", "参军", "丞相"]], "note": "南征献「攻心为上」之策。街亭违亮节度，为张郃所破；亮挥泪斩之。"},
		{"a": "liu-bei", "b": "ma-su", "p": [[null, 223, "other", "所戒", "戒之者"]], "note": "先主临薨谓亮：「马谡言过其实，不可大用」。"},
		{"a": "zhuge-liang", "b": "jiang-wei", "p": [[228, 234, "lord", "所得之才", "丞相"]], "note": "天水降蜀；亮称其「凉州上士」，授以兵法。"},
		{"a": "liu-bei", "b": "liu-shan", "p": [[null, null, "kin", "子", "父"]]},
		{"a": "liu-bei", "b": "liu-biao", "p": [[201, 208, "ally", "所依", "依附者"]]},
		{"a": "liu-biao", "b": "liu-qi", "p": [[null, null, "kin", "长子", "父"]]},
		{"a": "liu-biao", "b": "liu-zong", "p": [[null, null, "kin", "少子", "父"]], "note": "后妻蔡氏爱琮；刘琦不自安，求出为江夏太守。"},
		{"a": "liu-qi", "b": "zhuge-liang", "p": [[207, 207, "ally", "问计之人", "问计者"]], "note": "上屋去梯问计，亮以申生在内而危、重耳在外而安答之。"},
		{"a": "liu-zong", "b": "cao-cao", "p": [[208, 208, "foe", "受降者", "降者"]]},
		{"a": "liu-bei", "b": "liu-qi", "p": [[208, 209, "ally", "盟友", "盟友"]]},
		{"a": "liu-bei", "b": "liu-zhang", "p": [[211, 212, "ally", "同宗、邀者", "所邀"], [212, 214, "foe", "敌", "敌"]], "note": "刘璋迎先主入蜀以拒张鲁，先主反攻之，围成都，璋出降。"},
		{"a": "liu-zhang", "b": "zhang-lu", "p": [[200, 215, "foe", "敌", "敌"]]},
		{"a": "liu-bei", "b": "lu-bu", "p": [[196, 198, "foe", "袭夺徐州者", "所袭"]], "note": "白门楼，太祖欲缓布，先主曰「明公不见布之事丁建阳及董太师乎」，遂缢杀之。"},
		{"a": "liu-bei", "b": "tao-qian", "p": [[193, 194, "lord", "荐主", "部将"]], "note": "陶谦表先主为豫州刺史；临终让徐州。"},
		{"a": "liu-bei", "b": "cao-cao", "p": [[196, 199, "lord", "所依", "依附者"], [199, 220, "foe", "敌", "敌"]], "note": "「今天下英雄，惟使君与操耳」；先主方食，失匕箸。"},
		{"a": "liu-bei", "b": "yuan-shao", "p": [[200, 201, "ally", "所依", "依附者"]]},
		{"a": "lu-bu", "b": "cao-cao", "p": [[194, 198, "foe", "敌", "敌"]], "note": "白门楼缢杀。"},
		{"a": "tao-qian", "b": "cao-cao", "p": [[193, 194, "foe", "敌", "敌"]], "note": "太祖父曹嵩避难琅邪，为陶谦部下所害；太祖征徐州，多所残戮。"},
		{"a": "cao-cao", "b": "zhang-xiu", "p": [[197, 197, "foe", "叛者", "所袭"], [199, 207, "lord", "降将", "主"]], "note": "宛城：太祖纳张济之妻，绣反，长子昂、侄安民、典韦皆死。后从贾诩之计归降。"},
		{"a": "cao-cao", "b": "zhang-lu", "p": [[215, 216, "lord", "降者", "受降者"]]},
		{"a": "liu-bei", "b": "zhang-jiao", "p": [[184, 184, "foe", "所讨", "讨之者"]], "note": "先主率其属从校尉邹靖讨黄巾贼有功。"},
		{"a": "cao-cao", "b": "zhang-jiao", "p": [[184, 184, "foe", "所讨", "讨之者"]], "note": "太祖为骑都尉，讨颍川黄巾。"},
		{"a": "zhang-jiao", "b": "han-lingdi", "p": [[184, 184, "foe", "所反", "反者"]]}
	]
}
