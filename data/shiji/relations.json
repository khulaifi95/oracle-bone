		{"a": "ziying", "b": "zhao-gao", "p": [[-207, -207, "foe", "所刺", "刺之者"]], "note": "子婴称病不行，使宦者韩谈刺杀赵高于斋宫。"},
		{"a": "ziying", "b": "liu-bang", "p": [[-207, -207, "foe", "受降者", "降者"]], "note": "素车白马，系颈以组，降轵道旁。"},
		{"a": "ziying", "b": "xiang-yu", "p": [[-206, -206, "foe", "杀之者", "所杀"]]},
