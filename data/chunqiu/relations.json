{
	"$comment": "人物关系。每条：a、b 两人；p 为分期，[起年, 止年, 类, b 之于 a, a 之于 b]，年为公元纪年（负为前），null 为不详或终身；类：kin 亲族，lord 君臣主从，ally 交游同盟，foe 敌对，other 其他。note 一句点出此关系在史文中的关节。",
	"relations": [
		{"a": "lu-yingong", "b": "lu-huigong", "p": [[null, -723, "kin", "父", "子"]], "note": "隐公，惠公继室声子所生。"},
		{"a": "lu-huigong", "b": "zhong-zi", "p": [[null, -723, "kin", "夫人", "夫"]], "note": "仲子生而有文在其手曰「为鲁夫人」，故归于鲁，生桓公。"},
		{"a": "lu-yingong", "b": "zhong-zi", "p": [[-723, -721, "kin", "庶母", "子"]], "note": "惠公薨，隐公以桓公尚幼，摄位以待之。"},
		{"a": "lu-xigong", "b": "zang-wenzhong", "p": [[-659, -627, "lord", "大夫", "君"]]},
		{"a": "zang-wenzhong", "b": "zhan-xi", "p": [[-634, -634, "lord", "所使", "使之者"]], "note": "齐师伐鲁，公使展喜犒师，使受命于展禽。"},
		{"a": "zhan-xi", "b": "liuxia-hui", "p": [[-634, -634, "kin", "族人（展禽）", "族人"]], "note": "展喜受辞于展禽，以「先王之命」退齐师。"},
		{"a": "zhan-xi", "b": "qi-xiaogong", "p": [[-634, -634, "other", "所说", "说之者"]], "note": "齐侯问「鲁人恐乎」，对曰「小人恐矣，君子则否」，齐侯乃还。"},
		{"a": "zang-wenzhong", "b": "liuxia-hui", "p": [[null, null, "other", "所不举", "不举者"]], "note": "孔子讥臧文仲「知柳下惠之贤而不与立」。"},
		{"a": "lu-xigong", "b": "qi-xiaogong", "p": [[-634, -634, "foe", "敌", "敌"]]},
		{"a": "zhou-pingwang", "b": "zheng-zhuanggong", "p": [[-743, -720, "lord", "卿士", "天子"]], "note": "王贰于虢，郑伯怨王；周郑交质，王子狐为质于郑，郑公子忽为质于周。"},
		{"a": "zheng-zhuanggong", "b": "gongshu-duan", "p": [[null, null, "kin", "弟", "兄"], [-722, -722, "foe", "所伐", "伐之者"]], "note": "「多行不义，必自毙」。郑伯克段于鄢，段出奔共。"},
		{"a": "zheng-zhuanggong", "b": "wu-jiang", "p": [[null, null, "kin", "母", "子"]], "note": "庄公寤生，惊姜氏，遂恶之；姜氏为段请京。克段后置之城颍，誓「不及黄泉，无相见也」，既而悔之。"},
		{"a": "gongshu-duan", "b": "wu-jiang", "p": [[null, null, "kin", "母", "子"]], "note": "武姜爱共叔段，欲立之，亟请于武公，公弗许。"},
		{"a": "zheng-zhuanggong", "b": "yingkao-shu", "p": [[-722, -712, "lord", "封人", "君"]], "note": "颍考叔舍肉遗母，庄公感之；掘地及泉，隧而相见，母子如初。"},
		{"a": "zheng-zhuanggong", "b": "zhai-zhong", "p": [[-743, -701, "lord", "卿", "君"]], "note": "祭仲谏京城太叔「都城过百雉，国之害也」。"},
		{"a": "zhou-xiangwang", "b": "wangzi-dai", "p": [[null, null, "kin", "弟", "兄"], [-636, -635, "foe", "作乱者", "所逐"]], "note": "王子带以狄师伐周，王出适郑，处于氾。"},
		{"a": "zhou-xiangwang", "b": "fu-chen", "p": [[-636, -636, "lord", "大夫", "天子"]], "note": "谏王勿以狄伐郑，王弗听；狄师之乱，富辰死之。"},
		{"a": "jin-wengong", "b": "zhou-xiangwang", "p": [[-635, -635, "lord", "天子", "勤王者"]], "note": "晋侯勤王，杀王子带，纳王于王城；请隧，弗许，赐之阳樊、温、原、欑茅之田。"},
		{"a": "jin-wengong", "b": "wangzi-dai", "p": [[-635, -635, "foe", "所杀", "杀之者"]]},
		{"a": "zheng-wengong", "b": "zhu-zhiwu", "p": [[-630, -630, "lord", "所使", "君"]], "note": "夜缒而出，见秦伯，「若亡郑而有益于君，敢以烦执事」，秦师遂还。"},
		{"a": "zhu-zhiwu", "b": "qin-mugong", "p": [[-630, -630, "other", "所说", "说之者"]]},
		{"a": "zheng-wengong", "b": "shu-zhan", "p": [[null, -628, "lord", "大夫", "君"]]},
		{"a": "zheng-wengong", "b": "jin-wengong", "p": [[-637, -637, "foe", "过郑者", "不礼之者"], [-630, -630, "foe", "围郑者", "所围"]], "note": "重耳过郑，郑文公不礼焉；叔詹谏，不听。后秦晋围郑。"},
		{"a": "zheng-wengong", "b": "zheng-mugong", "p": [[null, null, "kin", "子", "父"]]},
		{"a": "zheng-mugong", "b": "xian-gao", "p": [[-627, -627, "other", "救国之商人", "所救"]]},
		{"a": "xian-gao", "b": "mengming-shi", "p": [[-627, -627, "foe", "所犒之敌", "犒师者"]], "note": "郑商人弦高将市于周，遇秦师，以乘韦先牛十二犒师，且使遽告于郑。"},
		{"a": "jin-wengong", "b": "jin-huigong", "p": [[null, null, "kin", "异母弟", "兄"], [-650, -637, "foe", "仇", "仇"]], "note": "惠公使寺人披刺重耳于狄。"},
		{"a": "jin-huigong", "b": "jin-huaigong", "p": [[null, null, "kin", "子", "父"]]},
		{"a": "jin-wengong", "b": "jin-huaigong", "p": [[-637, -636, "foe", "所杀之侄", "叔父"]], "note": "怀公立，命从亡者归，弗召；重耳入，怀公奔高梁，被杀。"},
		{"a": "jin-wengong", "b": "jin-xianggong", "p": [[null, null, "kin", "子", "父"]]},
		{"a": "jin-wengong", "b": "hu-yan", "p": [[null, -629, "kin", "舅（子犯）", "甥"], [-655, -629, "lord", "从亡之臣", "主"]], "note": "从亡十九年。在齐，与姜氏谋，醉而遣之；河上授璧，请亡。"},
		{"a": "jin-wengong", "b": "zhao-shuai", "p": [[-655, -622, "lord", "从亡之臣", "主"]], "note": "从亡十九年；季隗之姊叔隗嫁之，生赵盾。"},
		{"a": "jin-wengong", "b": "jie-zhitui", "p": [[-655, -636, "lord", "从亡之臣", "主"]], "note": "介之推不言禄，禄亦弗及；与母偕隐而死，晋侯以绵上为之田。"},
		{"a": "jin-wengong", "b": "xian-zhen", "p": [[-633, -628, "lord", "中军元帅", "主"]], "note": "城濮之谋多出先轸。"},
		{"a": "jin-wengong", "b": "xi-hu", "p": [[-633, -632, "lord", "中军元帅", "主"]], "note": "被庐之蒐，作三军，赵衰荐郤縠「说礼乐而敦诗书」。"},
		{"a": "jin-wengong", "b": "luan-zhi", "p": [[-633, -628, "lord", "下军将", "主"]], "note": "城濮，曳柴而伪遁。"},
		{"a": "jin-wengong", "b": "xu-chen", "p": [[-655, -628, "lord", "下军佐", "主"]], "note": "城濮，蒙马以虎皮，先犯陈、蔡。"},
		{"a": "jin-wengong", "b": "siren-pi", "p": [[-655, -637, "foe", "刺客", "所刺"], [-636, -628, "lord", "告难者", "君"]], "note": "两度奉命行刺，斩其袪；文公初立，披求见，告吕甥、郤芮之谋，乃免于难。"},
		{"a": "jin-wengong", "b": "huai-ying", "p": [[-637, -628, "kin", "妻", "夫"]], "note": "本怀公（子圉）之妻，秦伯纳女五人；奉匜沃盥，既而挥之，嬴怒曰「秦晋匹也，何以卑我」。"},
		{"a": "huai-ying", "b": "jin-huaigong", "p": [[-643, -638, "kin", "前夫", "妻"]], "note": "子圉质于秦，秦以嬴妻之；子圉逃归，嬴不从亦不泄。"},
		{"a": "huai-ying", "b": "qin-mugong", "p": [[null, null, "kin", "父（一说宗女）", "女"]]},
		{"a": "jin-wengong", "b": "ji-wei", "p": [[-655, -644, "kin", "妻", "夫"]], "note": "在狄所娶；将适齐，谓之「待我二十五年不来而后嫁」。"},
		{"a": "jin-wengong", "b": "qi-jiang", "p": [[-644, -637, "kin", "妻", "夫"]], "note": "齐桓公妻之；重耳安于齐，姜氏与子犯谋，醉而遣之，曰「怀与安，实败名」。"},
		{"a": "jin-wengong", "b": "qi-huangong", "p": [[-644, -643, "kin", "岳父", "婿"]]},
		{"a": "jin-wengong", "b": "chu-chengwang", "p": [[-637, -637, "other", "主人", "客"], [-632, -632, "foe", "敌", "敌"]], "note": "楚子飨之，问何以报，对曰「若以君之灵，得反晋国，晋楚治兵遇于中原，其辟君三舍」。城濮果退三舍。"},
		{"a": "chu-chengwang", "b": "zi-yu", "p": [[-634, -632, "lord", "令尹", "君"]], "note": "城濮之败，楚子使谓之「大夫若入，其若申、息之老何」，子玉自杀于连谷。"},
		{"a": "chu-chengwang", "b": "zi-wen", "p": [[null, -637, "lord", "令尹", "君"]]},
		{"a": "zi-wen", "b": "zi-yu", "p": [[-637, -632, "ally", "所荐", "荐之者"]], "note": "子文让政于子玉，以靖国也。"},
		{"a": "wei-jia", "b": "zi-yu", "p": [[-633, -633, "other", "所讥", "讥之者"]], "note": "蒍贾尚幼，独后至不贺，曰「子玉刚而无礼，不可以治民；过三百乘，其不能以入矣」。"},
		{"a": "jin-wengong", "b": "zi-yu", "p": [[-632, -632, "foe", "敌", "敌"]]},
		{"a": "xian-zhen", "b": "zi-yu", "p": [[-632, -632, "foe", "敌", "敌"]]},
		{"a": "jin-wengong", "b": "qin-mugong", "p": [[-637, -628, "kin", "岳父", "婿"], [-636, -630, "ally", "纳之者", "所纳"]], "note": "秦伯纳重耳为晋君；后同伐郑，烛之武说秦，秦师独退。"},
		{"a": "qin-mugong", "b": "jin-huigong", "p": [[-651, -646, "ally", "所纳之君", "纳之者"], [-645, -645, "foe", "所获", "获之者"]], "note": "秦纳惠公而惠公背赂；韩之战，秦获晋侯。"},
		{"a": "qin-mugong", "b": "jian-shu", "p": [[-627, -627, "lord", "老臣", "君"]], "note": "哭师：「孟子，吾见师之出而不见其入也」；「尔何知！中寿，尔墓之木拱矣」。"},
		{"a": "jian-shu", "b": "xiqi-shu", "p": [[null, null, "kin", "子（《史记》说）", "父"]], "note": "蹇叔之子与师，哭而送之：「晋人御师必于殽」。"},
		{"a": "jian-shu", "b": "baiyi-bing", "p": [[null, null, "kin", "子（《史记》说）", "父"]]},
		{"a": "qin-mugong", "b": "mengming-shi", "p": [[-628, -621, "lord", "将", "君"]], "note": "殽之败，秦伯素服郊次，乡师而哭，不替孟明。"},
		{"a": "xian-zhen", "b": "mengming-shi", "p": [[-627, -627, "foe", "所虏", "虏之者"]], "note": "殽之战，晋人获百里孟明视、西乞术、白乙丙以归。"},
		{"a": "jin-xianggong", "b": "mengming-shi", "p": [[-627, -627, "foe", "所释", "释之者"]], "note": "文嬴请三帅，公许之；先轸怒，不顾而唾。"},
		{"a": "jin-xianggong", "b": "xian-zhen", "p": [[-628, -627, "lord", "中军元帅", "君"]]},
		{"a": "jin-wengong", "b": "cao-gonggong", "p": [[-637, -637, "foe", "窥浴者", "所窥"], [-632, -632, "foe", "所执", "执之者"]], "note": "曹共公闻其骈胁，欲观其裸，浴，薄而观之。城濮之前入曹，执曹伯。"},
		{"a": "cao-gonggong", "b": "xi-fuji", "p": [[-637, -632, "lord", "大夫", "君"]]},
		{"a": "xi-fuji", "b": "jin-wengong", "p": [[-637, -632, "ally", "所礼", "礼之者"]], "note": "僖负羁馈盘飧，置璧焉；晋入曹，令无入僖负羁之宫而免其族。"},
		{"a": "jin-wengong", "b": "wei-wengong", "p": [[-637, -637, "foe", "不礼之者", "所过"]]},
		{"a": "jin-wengong", "b": "wei-chenggong", "p": [[-632, -632, "foe", "敌", "敌"]]},
		{"a": "wei-chenggong", "b": "wei-wengong", "p": [[null, null, "kin", "父", "子"]]},
		{"a": "jin-wengong", "b": "song-chenggong", "p": [[-633, -632, "ally", "告急者", "所援"]], "note": "宋人告急于晋，先轸曰「报施救患，取威定霸，于是乎在矣」。"},
		{"a": "song-xianggong", "b": "song-chenggong", "p": [[null, null, "kin", "子", "父"]]},
		{"a": "song-xianggong", "b": "zi-yu-song", "p": [[null, null, "kin", "庶兄（目夷）", "弟"]], "note": "泓之战，子鱼请及楚师未既济而击之，公曰「不可」；师败，公伤股。"},
		{"a": "song-xianggong", "b": "gongsun-gu", "p": [[-638, -638, "lord", "大司马", "君"]]},
		{"a": "song-xianggong", "b": "chu-chengwang", "p": [[-638, -638, "foe", "敌", "敌"]]},
		{"a": "song-xianggong", "b": "jin-wengong", "p": [[-638, -638, "ally", "所礼", "礼之者"]], "note": "重耳过宋，襄公赠马二十乘。"},
		{"a": "qi-huangong", "b": "qi-xiaogong", "p": [[null, null, "kin", "子", "父"]]}
	]
}
