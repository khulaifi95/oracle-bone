		{"a": "tian-rong", "b": "tian-du", "p": [[-206, -206, "foe", "所逐", "逐之者"]]},
		{"a": "tian-rong", "b": "tian-an", "p": [[-206, -206, "foe", "所杀", "杀之者"]]},
		{"a": "xiang-yu", "b": "tian-rong", "p": [[-206, -205, "foe", "敌", "敌"]], "note": "项王北击齐，田荣败走平原，平原民杀之。"},
		{"a": "xiang-yu", "b": "tian-du", "p": [[-206, -206, "lord", "所封齐王", "封之者"]], "note": "从项羽救赵入关，封齐王。"},
		{"a": "xiang-yu", "b": "tian-an", "p": [[-206, -206, "lord", "所封济北王", "封之者"]]},
		{"a": "xiang-yu", "b": "tian-shi", "p": [[-206, -206, "lord", "所徙胶东王", "徙之者"]]},
		{"a": "liu-bang", "b": "tian-heng", "p": [[-202, -202, "foe", "所召", "召之者"]], "note": "高祖召横，横至尸乡自刭；其客五百人闻之，皆自杀。"},
		{"a": "tian-dan", "b": "zhang-han", "p": [[-208, -208, "foe", "杀之者", "所杀"]], "note": "章邯夜衔枚击魏、齐军，杀田儋于临济下。"},
		{"a": "wei-jiu", "b": "zhang-han", "p": [[-208, -208, "foe", "围之者", "所围"]], "note": "为其民约降，降定，自烧杀。"},
		{"a": "zhang-er", "b": "chen-yu", "p": [[null, -207, "ally", "刎颈之交", "刎颈之交"], [-207, -204, "foe", "仇", "仇"]], "note": "陈馀年少，父事张耳，相与为刎颈交。巨鹿之围馀不敢救，二人遂隙，馀解印去；后张耳从韩信破赵，斩陈馀泜水上。"},
		{"a": "liu-bang", "b": "zhang-er", "p": [[null, -209, "ally", "故交", "故交"], [-205, -202, "lord", "赵王", "君"]], "note": "高祖为布衣时，尝数从张耳游；失国后归汉。"},
		{"a": "zhang-er", "b": "zhao-xie", "p": [[-208, -206, "lord", "所立之王", "立之者"]]},
		{"a": "chen-yu", "b": "zhao-xie", "p": [[-208, -204, "lord", "所立之王", "立之者"]]},
		{"a": "xiang-yu", "b": "zhang-er", "p": [[-206, -206, "lord", "所封常山王", "封之者"]]},
		{"a": "xiang-yu", "b": "zhao-xie", "p": [[-207, -206, "ally", "所救", "救之者"]], "note": "巨鹿之围，诸侯军皆壁上观，楚兵破釜沉舟，九战而解赵围。"},
		{"a": "zhao-xie", "b": "wang-li", "p": [[-207, -207, "foe", "围之者", "所围"]]},
