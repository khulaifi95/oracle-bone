		{"a": "zang-tu", "b": "han-guang", "p": [[-206, -206, "foe", "所杀", "杀之者"]], "note": "臧荼徙韩广于辽东，广不听，击杀之无终。"},
		{"a": "xiang-yu", "b": "sima-ang", "p": [[-206, -206, "lord", "所封殷王", "封之者"]]},
