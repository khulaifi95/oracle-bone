		{"a": "liu-bang", "b": "sima-xin", "p": [[-206, -205, "foe", "降者", "所降"]]},
		{"a": "liu-bang", "b": "dong-yi", "p": [[-206, -205, "foe", "降者", "所降"]]},
		{"a": "sima-xin", "b": "zhang-han", "p": [[-208, -207, "lord", "上司", "长史"]], "note": "赵高疑章邯，司马欣还报，说章邯降楚。"},
		{"a": "qin-shihuang", "b": "li-si", "p": [[-246, -210, "lord", "丞相", "君"]]},
