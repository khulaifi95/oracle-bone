		{"a": "xiang-yu", "b": "she-jian", "p": [[-207, -207, "foe", "所破", "破之者"]], "note": "涉间不降楚，自烧杀。"},
		{"a": "zhang-han", "b": "wang-li", "p": [[-208, -207, "ally", "同僚", "同僚"]]},
