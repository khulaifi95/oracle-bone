		{"a": "liu-bang", "b": "qin-shihuang", "p": [[null, -210, "other", "所观", "观者"]], "note": "常繇咸阳，纵观秦皇帝，喟然太息曰「嗟乎，大丈夫当如此也」。"}
	]
}
