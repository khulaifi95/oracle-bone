		{"a": "qin-shihuang", "b": "qin-ershi", "p": [[null, -210, "kin", "少子", "父"]]},
		{"a": "qin-ershi", "b": "zhao-gao", "p": [[-210, -208, "lord", "郎中令", "君"], [-208, -207, "lord", "丞相", "君"], [-207, -207, "foe", "弑君者", "所弑"]], "note": "指鹿为马，群臣莫敢言；望夷宫之变，逼二世自杀。"},
